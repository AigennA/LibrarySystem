@page "/books/{Id:int}"
@rendermode InteractiveServer
@inject IBookRepository BookRepo
@inject ILoanRepository LoanRepo
@inject IMemberRepository MemberRepo
@inject NavigationManager Nav

<PageTitle>Bokdetaljer</PageTitle>

@if (book == null)
{
    <p><em>Laddar...</em></p>
}
else
{
    <h1>@book.Title</h1>

    <div class="card mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Författare</dt>
                <dd class="col-sm-9">@book.Author</dd>
                <dt class="col-sm-3">Utgivningsår</dt>
                <dd class="col-sm-9">@book.PublishedYear</dd>
                <dt class="col-sm-3">ISBN</dt>
                <dd class="col-sm-9">@book.ISBN</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (book.IsAvailable)
                    {
                        <span class="badge bg-success">Tillgänglig</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Utlanad</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    @if (book.IsAvailable)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>Låna ut</h5>
                <div class="row">
                    <div class="col-md-6">
                        <select class="form-select" @bind="selectedMemberId">
                            <option value="">-- Välj medlem --</option>
                            @if (members != null)
                            {
                                @foreach (var m in members)
                                {
                                    <option value="@m.MemberId">@m.Name (@m.MemberId)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary" @onclick="LoanBook" disabled="@string.IsNullOrEmpty(selectedMemberId)">Låna ut</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert alert-info mt-2">@message</div>
                }
            </div>
        </div>
    }
    else if (activeLoan != null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>Aktivt lån</h5>
                <p>Lånad av: @activeLoan.Member.Name, Lånedatum: @activeLoan.LoanDate.ToString("yyyy-MM-dd"), Förfallodatum: @activeLoan.DueDate.ToString("yyyy-MM-dd")</p>
                <button class="btn btn-warning" @onclick="ReturnBook">Returnera</button>
                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert alert-info mt-2">@message</div>
                }
            </div>
        </div>
    }

    <h3>Lånhistorik</h3>
    @if (loans != null && loans.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Medlem</th>
                    <th>Lånedatum</th>
                    <th>Förfallodatum</th>
                    <th>Returdatum</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in loans)
                {
                    <tr>
                        <td>@loan.Member.Name</td>
                        <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                        <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                        <td>@(loan.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>
                            @if (loan.IsReturned)
                            {
                                <span class="badge bg-secondary">Returnerad</span>
                            }
                            else if (loan.IsOverdue)
                            {
                                <span class="badge bg-danger">Försenad</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Aktiv</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Inga lån finns för denna bok.</p>
    }

    <a href="books" class="btn btn-outline-secondary mt-3">Tillbaka till boklistan</a>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Book? book;
    private List<Loan>? loans;
    private Loan? activeLoan;
    private List<Member>? members;
    private string selectedMemberId = string.Empty;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        book = await BookRepo.GetByIdAsync(Id);
        if (book == null) return;

        var allLoans = await LoanRepo.GetAllAsync();
        loans = allLoans.Where(l => l.BookId == book.Id).OrderByDescending(l => l.LoanDate).ToList();
        activeLoan = loans.FirstOrDefault(l => !l.IsReturned);
        members = (await MemberRepo.GetAllAsync()).ToList();
    }

    private async Task LoanBook()
    {
        if (book == null || string.IsNullOrEmpty(selectedMemberId)) return;

        var member = await MemberRepo.GetByIdAsync(selectedMemberId);
        if (member == null) return;

        var loan = new Loan(book, member, DateTime.Now, DateTime.Now.AddDays(14));
        book.IsAvailable = false;
        await LoanRepo.AddAsync(loan);
        await BookRepo.UpdateAsync(book);

        message = "Boken har lånats ut!";
        selectedMemberId = string.Empty;
        await LoadData();
    }

    private async Task ReturnBook()
    {
        if (activeLoan == null || book == null) return;

        activeLoan.ReturnBook();
        await LoanRepo.UpdateAsync(activeLoan);
        await BookRepo.UpdateAsync(book);

        message = "Boken har returnerats!";
        await LoadData();
    }
}
