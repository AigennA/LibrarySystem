@page "/members"
@rendermode InteractiveServer
@inject IMemberRepository MemberRepo
@inject ILoanRepository LoanRepo

<PageTitle>Medlemmar</PageTitle>

<h1>Medlemmar</h1>

<div class="mb-3 text-end">
    <button class="btn btn-success" @onclick="ToggleAddForm">
        @(showAddForm ? "Stäng" : "Lägg till medlem")
    </button>
</div>

@if (showAddForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Lägg till ny medlem</h5>
            <EditForm Model="newMember" OnValidSubmit="AddMember" FormName="addMember">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <label class="form-label">Medlems-ID</label>
                        <InputText class="form-control" @bind-Value="newMember.MemberId" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">Namn</label>
                        <InputText class="form-control" @bind-Value="newMember.Name" />
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">E-post</label>
                        <InputText class="form-control" @bind-Value="newMember.Email" />
                    </div>
                    <div class="col-md-2 mb-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-success">Spara</button>
                    </div>
                </div>
            </EditForm>
            @if (!string.IsNullOrEmpty(addMessage))
            {
                <div class="alert alert-info mt-2">@addMessage</div>
            }
        </div>
    </div>
}

@if (members == null)
{
    <p><em>Laddar...</em></p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Medlems-ID</th>
                <th>Namn</th>
                <th>E-post</th>
                <th>Medlem sedan</th>
                <th>Aktiva lån</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in members)
            {
                <tr>
                    <td>@member.MemberId</td>
                    <td>@member.Name</td>
                    <td>@member.Email</td>
                    <td>@member.MemberSince.ToString("yyyy-MM-dd")</td>
                    <td>
                        @{
                            var count = activeLoanCounts.GetValueOrDefault(member.MemberId, 0);
                        }
                        @if (count > 0)
                        {
                            <span class="badge bg-warning">@count</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">0</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Member>? members;
    private Dictionary<string, int> activeLoanCounts = new();
    private MemberFormModel newMember = new();
    private bool showAddForm;
    private string addMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        members = (await MemberRepo.GetAllAsync()).ToList();
        var activeLoans = await LoanRepo.GetActiveLoansAsync();
        activeLoanCounts = activeLoans
            .GroupBy(l => l.MemberId)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private void ToggleAddForm()
    {
        showAddForm = !showAddForm;
        addMessage = string.Empty;
    }

    private async Task AddMember()
    {
        if (string.IsNullOrWhiteSpace(newMember.MemberId) || string.IsNullOrWhiteSpace(newMember.Name) || string.IsNullOrWhiteSpace(newMember.Email))
        {
            addMessage = "Alla fält måste fyllas i.";
            return;
        }

        var member = new Member(newMember.MemberId, newMember.Name, newMember.Email);
        await MemberRepo.AddAsync(member);
        newMember = new MemberFormModel();
        addMessage = "Medlemmen har lagts till!";
        await LoadMembers();
    }

    private class MemberFormModel
    {
        public string MemberId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }
}
