@page "/"
@rendermode InteractiveServer
@inject IBookRepository BookRepo
@inject IMemberRepository MemberRepo
@inject ILoanRepository LoanRepo

<PageTitle>Hem - Bibliotekssystem</PageTitle>

<h1>Välkommen till Bibliotekssystemet!</h1>
<p class="lead">Här kan du hantera böcker, medlemmar och utlåningar på ett enkelt sätt.</p>

@if (loaded)
{
    <div class="row mt-4">
        <div class="col-md-3 mb-3">
            <div class="book-card stat-card-books">
                <div class="book-left-page">
                    <h5 class="card-title mb-0">Böcker</h5>
                </div>
                <div class="book-right-page">
                    <p class="display-5">@totalBooks</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="book-card stat-card-members">
                <div class="book-left-page">
                    <h5 class="card-title mb-0">Medlemmar</h5>
                </div>
                <div class="book-right-page">
                    <p class="display-5">@totalMembers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="book-card stat-card-loans">
                <div class="book-left-page">
                    <h5 class="card-title mb-0">Aktiva lån</h5>
                </div>
                <div class="book-right-page">
                    <p class="display-5">@activeLoans</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="book-card stat-card-overdue">
                <div class="book-left-page">
                    <h5 class="card-title mb-0">Försenade</h5>
                </div>
                <div class="book-right-page">
                    <p class="display-5">@overdueLoans</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="books" class="btn btn-primary me-2">Boklista</a>
        <a href="members" class="btn btn-success me-2">Medlemmar</a>
        <a href="loans" class="btn btn-warning">Utlåningar</a>
    </div>
}
else
{
    <p><em>Laddar...</em></p>
}

@code {
    private int totalBooks;
    private int totalMembers;
    private int activeLoans;
    private int overdueLoans;
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        var books = await BookRepo.GetAllAsync();
        var members = await MemberRepo.GetAllAsync();
        var active = await LoanRepo.GetActiveLoansAsync();
        var overdue = await LoanRepo.GetOverdueLoansAsync();

        totalBooks = books.Count();
        totalMembers = members.Count();
        activeLoans = active.Count();
        overdueLoans = overdue.Count();
        loaded = true;
    }
}
