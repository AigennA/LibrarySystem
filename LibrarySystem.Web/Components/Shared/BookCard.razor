<div class="card h-100">
    <div class="card-body">
        <h5 class="card-title">@Book.Title</h5>
        <h6 class="card-subtitle mb-2 text-muted">@Book.Author (@Book.PublishedYear)</h6>
        <p class="card-text">ISBN: @Book.ISBN</p>
        @if (Book.IsAvailable)
        {
            <span class="badge bg-success">Tillgänglig</span>
        }
        else
        {
            <span class="badge bg-danger">Utlanad</span>
        }
    </div>
</div>

@code {
    [Parameter]
    public Book Book { get; set; } = default!;
}
